<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="whendo"
        Arguments=""
        InstallLocation="C:\Program Files\SloanGwaltney\Whendo">
    </Installer>
    <PackageInformation
        PackageName="Whendo"
        PackageDisplayName="Whendo"
        PublisherName="CN=SloanGwaltney"
        PublisherDisplayName="SloanGwaltney"
        Version="0.1.0.0"
        PackageDescription="Stream automation for streamers">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.sloangwaltney.whendo"
                Description="Stream automation for streamers"
                DisplayName="Whendo"
                ExecutableName="whendo"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Whendo</DisplayName>
            <PublisherDisplayName>SloanGwaltney</PublisherDisplayName>
            <Description>Stream automation for streamers</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="whendo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
